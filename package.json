{
  "name": "dsh-personal-model-picker",
  "version": "1.1.1",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml",
      "order": {
        "after": [
          "@deepseek-ai/dsh-web-app"
        ]
      }
    }
  },
  "description": "Compact provider/model menu with a separate Chinese reasoning-effort selector for DeepSeek Harness.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ui",
    "models"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check dist/index.js && node --check dist/client.cjs"
  }
}
